generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EntityType {
  CIVILIZATION
  PERSON
  EVENT
  IDEA
  BOOK
}

model Civilization {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  nameVi      String?
  region      String?
  regionVi    String?
  periodStart Int?
  periodEnd   Int?
  summary     String?
  summaryVi   String?
  content     String?  @db.Text
  contentVi   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  people      Person[]

  @@index([slug])
}

model Person {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  nameVi         String?
  birthYear      Int?
  deathYear      Int?
  occupations    String?
  occupationsVi  String?
  summary        String?
  summaryVi      String?
  content        String?  @db.Text
  contentVi      String?  @db.Text
  civilizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  civilization Civilization? @relation(fields: [civilizationId], references: [id])

  @@index([slug])
  @@index([civilizationId])
}

model Event {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  titleVi   String?
  startYear Int?
  endYear   Int?
  summary   String?
  summaryVi String?
  content   String?  @db.Text
  contentVi String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model Idea {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  titleVi    String?
  category   String?
  categoryVi String?
  summary    String?
  summaryVi  String?
  content    String?  @db.Text
  contentVi  String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([slug])
}

model Book {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  titleVi         String?
  author          String?
  authorVi        String?
  publicationYear Int?
  summary         String?
  summaryVi       String?
  content         String?  @db.Text
  contentVi       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([slug])
}

model Relationship {
  id               String     @id @default(cuid())
  sourceId         String
  sourceType       EntityType
  targetId         String
  targetType       EntityType
  relationshipType String
  createdAt        DateTime @default(now())

  @@index([sourceId])
  @@index([targetId])
  @@index([relationshipType])
  @@unique([sourceId, targetId, relationshipType])
}

model Reference {
  id          String   @id @default(cuid())
  title       String
  url         String?
  doi         String?
  publisher   String?
  createdAt   DateTime @default(now())
}
